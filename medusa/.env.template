# Origins allowed to call the Store API. The storefront proxies store calls
# server-side, so this mainly matters if you call Medusa from a browser.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000
# Optional. Leave unset to use Medusa's in-memory event bus and cache locally.
# REDIS_URL=redis://localhost:6379
# Change both secrets to long random strings before deploying.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-store

DB_NAME=medusa_ci_seed